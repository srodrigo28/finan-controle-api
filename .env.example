FLASK_ENV=development
PORT=8000
DATABASE_URL=postgresql+psycopg://finan_user:finan_dev_senha@127.0.0.1:5434/finan_controle
SECRET_KEY=troque-esta-chave
JWT_SECRET_KEY=troque-esta-chave-tambem
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# Bucket (comprovantes) — sem BUCKET_URL os anexos ficam em disco
BUCKET_URL=https://99dev.pro/bucket
BUCKET_DEFAULT=finan-controle
BUCKET_TOKEN=
BUCKET_TIMEOUT=20
# Web Push (gerar com py_vapid) e token do cron diário de lembretes
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
CRON_TOKEN=
APP_URL=https://finan-controle.vercel.app

# ── E-mail (SMTP) — padrão 99dev, mesmas chaves em todos os projetos ─────────
# Gmail: senha de APP (16 chars, SEM os espaços que o Google mostra) em
# Conta Google > Segurança > Verificação em duas etapas > Senhas de app.
# MAIL_HOST vazio = a API só loga o e-mail (dev sem SMTP).
MAIL_FROM=Finan Controle <rodrigoexer1@gmail.com>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=rodrigoexer1@gmail.com
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_ASYNC=true

# ── Confirmação de cadastro (código de 4 dígitos) ───────────────────────────
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# Código MESTRE: 4 dígitos que confirmam QUALQUER conta sem e-mail nenhum.
# VAZIO = desligado (valor de produção). Em dev/e2e use 1234.
EMAIL_VERIFICATION_TEST_CODE=

# ── Esqueci minha senha ─────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=2
PASSWORD_RESET_RESEND_SECONDS=60
